          <div class="relative w-24 h-24 mx-auto flex items-center justify-center cursor-pointer">
            <svg class="absolute top-0 left-0 w-24 h-24 transform -rotate-90 pointer-events-none">
              <circle cx="48" cy="48" r="42" stroke="rgba(255,255,255,0.08)" stroke-width="4" fill="none"></circle>
              <circle id="holdProgressCircle" cx="48" cy="48" r="42" stroke="#ff8fa3" stroke-width="4" stroke-dasharray="264" stroke-dashoffset="264" stroke-linecap="round" fill="none" class="transition-all duration-75"></circle>
