<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>A Little Universe For Sneha Sherke ✨</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Three.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            roseGlow: '#ff4d6d',
            flirtNeon: '#ff1e56',
            deepSpace: '#050308',
            glassBg: 'rgba(255, 255, 255, 0.04)',
            glassBorder: 'rgba(255, 77, 109, 0.22)',
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
            script: ['Caveat', 'cursive'],
          }
        }
      }
    };
  </script>

  <style>
    * {
      -webkit-tap-highlight-color: transparent;
      box-sizing: border-box;
    }

    body {
      background-color: #06040a;
      color: #f9f5f6;
      overflow-x: hidden;
      min-height: 100vh;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    button, .mood-pill, .food-cat-btn, #touchCore {
      user-select: none;
      -webkit-user-select: none;
      cursor: pointer;
    }

    input, textarea {
      user-select: text !important;
      -webkit-user-select: text !important;
    }

    #webglCanvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none !important;
    }

    #ambientGlow {
      position: fixed;
      width: 580px;
      height: 580px;
      border-radius: 50%;
      top: -120px;
      left: 50%;
      transform: translateX(-50%);
      background: radial-gradient(circle, rgba(255, 30, 86, 0.35) 0%, transparent 70%);
      filter: blur(140px);
      z-index: 1;
      pointer-events: none !important;
      transition: background 0.8s ease;
    }

    #foregroundUI {
      position: relative;
      z-index: 20;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid rgba(255, 143, 163, 0.18);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: 0 15px 45px rgba(0, 0, 0, 0.6);
    }

    .glass-pill {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 143, 163, 0.14);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #06040a; }
    ::-webkit-scrollbar-thumb { background: rgba(255, 143, 163, 0.2); border-radius: 10px; }

    @keyframes floatChibi {
      0%, 100% { transform: translateY(0px) rotate(-1.5deg); }
      50% { transform: translateY(-9px) rotate(1.5deg); }
    }
    .chibi-float {
      animation: floatChibi 3.6s ease-in-out infinite;
    }

    .disintegrate { animation: disintegrateAnim 0.7s forwards ease-in-out; }
    @keyframes disintegrateAnim {
      0% { transform: scale(1) rotate(0deg); filter: blur(0px); opacity: 1; }
      50% { transform: scale(0.6) rotate(15deg); filter: blur(6px) hue-rotate(90deg); opacity: 0.5; }
      100% { transform: scale(0.1) rotate(45deg); filter: blur(18px); opacity: 0; }
    }

    .scratch-container {
      position: relative;
      width: 100%;
      height: 155px;
      border-radius: 1rem;
      overflow: hidden;
    }

    #scratchCanvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      cursor: crosshair;
      z-index: 5;
      touch-action: none;
    }
  </style>
</head>

<body class="relative min-h-screen text-slate-100 antialiased selection:bg-roseGlow selection:text-black">

  <!-- Direct Audio Source (Ensure gaurai.mp3 is in the exact same folder) -->
  <audio id="bgMusic" src="gaurai.mp3" loop preload="auto" playsinline></audio>

  <canvas id="webglCanvas"></canvas>
  <div id="ambientGlow"></div>

  <div id="foregroundUI" class="relative z-20 max-w-4xl mx-auto px-4 sm:px-6 pt-8 pb-32">

    <!-- Top Telemetry, Music Toggle & Live Clock -->
    <header class="glass-pill flex items-center justify-between px-4 py-2 rounded-full mb-8 font-mono text-xs text-slate-300 max-w-2xl mx-auto gap-2">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-flirtNeon animate-ping"></span>
        <span class="w-2 h-2 rounded-full bg-flirtNeon -ml-4"></span>
        <span class="tracking-widest font-semibold text-rose-300 truncate">SNEHA SHERKE</span>
      </div>

      <div class="flex items-center gap-2.5">
        <button type="button" id="musicToggleBtn" onclick="toggleBgMusic(event)" class="px-3.5 py-1.5 rounded-full bg-roseGlow/20 border border-rose-400/40 text-rose-200 hover:bg-roseGlow hover:text-black font-semibold text-[11px] flex items-center gap-1.5 transition active:scale-95">
          <span id="musicIcon">🎵</span>
          <span id="musicLabel">Play Song</span>
        </button>
        <span class="text-rose-400 font-semibold tracking-wider hidden sm:inline" id="liveClock">16:08:00 IST</span>
      </div>
    </header>

    <!-- Hero Header with Cute Girl Cartoon Avatar -->
    <section class="text-center mb-10">
      <div class="relative w-32 h-32 mx-auto mb-4 chibi-float flex items-center justify-center">
        <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-flirtNeon/30 via-rose-400/20 to-purple-500/30 blur-xl"></div>
        <div class="relative w-28 h-28 rounded-full glass-card border-2 border-rose-300/40 flex items-center justify-center overflow-hidden shadow-xl shadow-rose-950/60">
          <svg viewBox="0 0 200 200" class="w-24 h-24" xmlns="http://www.w3.org/2000/svg">
            <circle cx="100" cy="100" r="88" fill="#1e0d1d" />
            <path d="M46 95 C40 140, 48 175, 65 182 L135 182 C152 175, 160 140, 154 95 C150 52, 50 52, 46 95 Z" fill="#231729"/>
            <path d="M62 152 C62 138, 138 138, 138 152 L148 190 L52 190 Z" fill="#ff4d6d"/>
            <path d="M84 143 Q100 158 116 143" fill="none" stroke="#ffd6e0" stroke-width="3" stroke-linecap="round"/>
            <rect x="91" y="124" width="18" height="20" rx="8" fill="#ffd9c4"/>
            <path d="M64 92 C64 64, 136 64, 136 92 C136 122, 118 134, 100 134 C82 134, 64 122, 64 92 Z" fill="#ffe3d3"/>
            <ellipse cx="77" cy="108" rx="8" ry="4.5" fill="#ff758f" opacity="0.55"/>
            <ellipse cx="123" cy="108" rx="8" ry="4.5" fill="#ff758f" opacity="0.55"/>
            <circle cx="83" cy="96" r="6.5" fill="#1f1226"/>
            <circle cx="81" cy="94" r="2.3" fill="#ffffff"/>
            <circle cx="85" cy="98" r="1.1" fill="#ffffff"/>
            <circle cx="117" cy="96" r="6.5" fill="#1f1226"/>
            <circle cx="115" cy="94" r="2.3" fill="#ffffff"/>
            <circle cx="119" cy="98" r="1.1" fill="#ffffff"/>
            <path d="M76 85 Q83 82 89 85" fill="none" stroke="#3b2645" stroke-width="2" stroke-linecap="round"/>
            <path d="M111 85 Q117 82 124 85" fill="none" stroke="#3b2645" stroke-width="2" stroke-linecap="round"/>
            <path d="M93 114 Q100 121 107 114" fill="none" stroke="#c94a6a" stroke-width="2.6" stroke-linecap="round"/>
            <path d="M60 88 C62 52, 138 52, 140 88 C132 72, 118 72, 112 84 C106 70, 94 70, 88 84 C82 72, 68 72, 60 88 Z" fill="#2d1e36"/>
            <path d="M126 70 C126 67, 122 67, 122 70 C122 73, 126 76, 126 76 C126 76, 130 73, 130 70 C130 67, 126 67, 126 70 Z" fill="#ff8fa3"/>
            <text x="34" y="64" font-size="14" fill="#ff4d6d">♥</text>
            <text x="152" y="58" font-size="12" fill="#ff8fa3">✨</text>
          </svg>
        </div>
      </div>

      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">
        A Little Universe For <span class="bg-gradient-to-r from-white via-rose-200 to-roseGlow bg-clip-text text-transparent">Sneha Sherke</span>
      </h1>
      <p class="text-sm text-slate-400 font-light max-w-md mx-auto leading-relaxed">
        Choose how you're feeling right now and let the words do the rest.
      </p>
    </section>

    <!-- 1. REFINED SPLIT STUDIO: MOOD SELECTOR (LEFT) & LIVE MESSAGE (RIGHT) -->
    <section class="mb-8">
      <div class="flex items-center justify-between mb-3 px-1">
        <div class="font-mono text-xs uppercase tracking-widest text-roseGlow flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-roseGlow animate-pulse"></span>
          <span>Emotional Frequency</span>
        </div>
        <span class="font-mono text-[11px] text-slate-400">10 States • Live Sync</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-stretch">
        
        <!-- LEFT PANEL: SLEEK MOOD DOCK -->
        <div class="md:col-span-4 glass-card rounded-3xl p-3.5 flex flex-col justify-between">
          <div class="font-mono text-[10px] uppercase tracking-wider text-slate-400 px-2 pb-2 mb-2 border-b border-white/5 flex justify-between items-center">
            <span>Select Vibe</span>
            <span class="text-rose-400">✦</span>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-1 gap-1.5" id="moodGrid">
            <button type="button" onclick="setMood('flirt', this)" class="mood-pill active px-3.5 py-2.5 rounded-2xl flex items-center justify-between text-left transition-all duration-300 border border-flirtNeon/60 shadow-md shadow-rose-950/50 bg-gradient-to-r from-flirtNeon/20 to-rose-500/10">
              <div class="flex items-center gap-2.5">
                <span class="text-lg">😏</span>
                <span class="text-xs font-bold text-rose-200">Sassy Flirt</span>
              </div>
              <span class="w-1.5 h-1.5 rounded-full bg-flirtNeon"></span>
            </button>

            <button type="button" onclick="setMood('stress', this)" class="mood-pill px-3.5 py-2.5 rounded-2xl flex items-center justify-between text-left transition-all duration-300 border border-transparent bg-white/[0.02] hover:bg-white/[0.06] hover:border-rose-400/20">
              <div class="flex items-center gap-2.5">
                <span class="text-lg">💼</span>
                <span class="text-xs font-medium text-slate-300">Burnout</span>
              </div>
            </button>

            <button type="button" onclick="setMood('low', this)" class="mood-pill px-3.5 py-2.5 rounded-2xl flex items-center justify-between text-left transition-all duration-300 border border-transparent bg-white/[0.02] hover:bg-white/[0.06] hover:border-rose-400/20">
              <div class="flex items-center gap-2.5">
                <span class="text-lg">🥺</span>
                <span class="text-xs font-medium text-slate-300">Overthinking</span>
              </div>
            </button>

            <button type="button" onclick="setMood('angry', this)" class="mood-pill px-3.5 py-2.5 rounded-2xl flex items-center justify-between text-left transition-all duration-300 border border-transparent bg-white/[0.02] hover:bg-white/[0.06] hover:border-rose-400/20">
              <div class="flex items-center gap-2.5">
                <span class="text-lg">😤</span>
                <span class="text-xs font-medium text-slate-300">Fiery Nakhra</span>
              </div>
            </button>

            <button type="button" onclick="setMood('drive', this)" class="mood-pill px-3.5 py-2.5 rounded-2xl flex items-center justify-between text-left transition-all duration-300 border border-transparent bg-white/[0.02] hover:bg-white/[0.06] hover:border-rose-400/20">
              <div class="flex items-center gap-2.5">
                <span class="text-lg">🚗</span>
                <span class="text-xs font-medium text-slate-300">Open Drive</span>
              </div>
            </button>

            <button type="button" onclick="setMood('happy', this)" class="mood-pill px-3.5 py-2.5 rounded-2xl flex items-center justify-between text-left transition-all duration-300 border border-transparent bg-white/[0.02] hover:bg-white/[0.06] hover:border-rose-400/20">
              <div class="flex items-center gap-2.5">
                <span class="text-lg">👑</span>
                <span class="text-xs font-medium text-slate-300">Queen Aura</span>
              </div>
            </button>

            <button type="button" onclick="setMood('night', this)" class="mood-pill px-3.5 py-2.5 rounded-2xl flex items-center justify-between text-left transition-all duration-300 border border-transparent bg-white/[0.02] hover:bg-white/[0.06] hover:border-rose-400/20">
              <div class="flex items-center gap-2.5">
                <span class="text-lg">🌙</span>
                <span class="text-xs font-medium text-slate-300">1:00 AM Sukoon</span>
              </div>
            </button>

            <button type="button" onclick="setMood('cravings', this)" class="mood-pill px-3.5 py-2.5 rounded-2xl flex items-center justify-between text-left transition-all duration-300 border border-transparent bg-white/[0.02] hover:bg-white/[0.06] hover:border-rose-400/20">
              <div class="flex items-center gap-2.5">
                <span class="text-lg">🍰</span>
                <span class="text-xs font-medium text-slate-300">Sweet Cravings</span>
              </div>
            </button>

            <button type="button" onclick="setMood('nostalgic', this)" class="mood-pill px-3.5 py-2.5 rounded-2xl flex items-center justify-between text-left transition-all duration-300 border border-transparent bg-white/[0.02] hover:bg-white/[0.06] hover:border-rose-400/20">
              <div class="flex items-center gap-2.5">
                <span class="text-lg">🌧️</span>
                <span class="text-xs font-medium text-slate-300">Nostalgic</span>
              </div>
            </button>

            <button type="button" onclick="setMood('blanket', this)" class="mood-pill px-3.5 py-2.5 rounded-2xl flex items-center justify-between text-left transition-all duration-300 border border-transparent bg-white/[0.02] hover:bg-white/[0.06] hover:border-rose-400/20">
              <div class="flex items-center gap-2.5">
                <span class="text-lg">🛋️</span>
                <span class="text-xs font-medium text-slate-300">Blanket Mode</span>
              </div>
            </button>
          </div>
        </div>

        <!-- RIGHT PANEL: LIVE MESSAGE CANVAS -->
        <div class="md:col-span-8 glass-card rounded-3xl p-6 sm:p-7 flex flex-col justify-between relative overflow-hidden">
          <div class="absolute -top-20 -right-20 w-44 h-44 bg-flirtNeon/10 rounded-full blur-3xl pointer-events-none"></div>

          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-6 pb-3.5 border-b border-white/10">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-flirtNeon"></span>
                <span id="activeMoodTag" class="font-mono text-[11px] uppercase tracking-widest text-rose-300 font-bold">
                  1,000+ ENGLISH FLIRT MATRIX
                </span>
              </div>
              <button type="button" onclick="generateProceduralMessage()" class="font-mono text-xs bg-roseGlow/15 text-rose-200 border border-rose-400/40 px-4 py-1.5 rounded-full flex items-center gap-1.5 hover:bg-roseGlow hover:text-black font-semibold transition active:scale-95">
                <span>↻</span> Next Line ✨
              </button>
            </div>

            <div class="min-h-[210px] flex flex-col justify-center mb-5">
              <p id="messageDisplay" class="font-sans font-semibold text-lg md:text-2xl text-white leading-relaxed tracking-wide mb-4 transition-opacity duration-200">
                "Honestly Sneha, smiling at your phone like that should officially be illegal, because you have this unfair habit of brightening anyone's mood in two seconds flat. Stop biting your lip and admit you love being this charming."
              </p>
              <div id="shayariHindiDisplay" class="font-script text-2xl md:text-3xl text-rose-300 leading-relaxed tracking-wide transition-opacity duration-200">
                "सच में Sneha, फोन देखकर मुस्कुराना बंद करो... तुम्हारा ये नखरा और मासूम अदा सच में बहुत प्यारी लगती है।"
              </div>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between font-mono text-[10px] text-slate-400 mb-3">
              <span>CALIBRATED FOR SNEHA</span>
              <span id="matrixCounter">Permutation #247 of 1,000+</span>
            </div>

            <div class="bg-black/45 border-l-2 border-flirtNeon rounded-2xl p-3.5 text-xs text-slate-300 leading-relaxed" id="actionProtocol">
              <strong class="font-mono uppercase text-flirtNeon block text-[10px] tracking-wider mb-0.5">Note To Self</strong>
              Put the phone down for 3 seconds, stop biting your lip, and admit you loved reading that.
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 2. SIDE-BY-SIDE UTILITY BAR (LEFT: 3D HEART ORBIT | RIGHT: QUICK DOPAMINE SHOT) -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <div class="glass-card rounded-3xl p-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-1">
            <span class="font-mono text-[10px] uppercase tracking-wider text-roseGlow">3D Heart Orbit</span>
            <span class="text-base">💓</span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed mb-3">
            Hundreds of pulsing 3D hearts float around you. Drag to rotate or double-tap for a burst.
          </p>
        </div>
        <div class="flex gap-2">
          <button type="button" onclick="triggerHeartSupernova()" class="flex-1 py-2 rounded-xl bg-rose-500/15 border border-rose-400/30 font-mono text-[10px] font-bold uppercase tracking-wider text-rose-200 hover:bg-roseGlow hover:text-black transition">
            Burst ✨
          </button>
          <button type="button" onclick="resetCameraAngle()" class="px-3 py-2 rounded-xl bg-white/5 border border-white/10 font-mono text-[10px] uppercase tracking-wider text-slate-300 hover:bg-white/10 transition">
            Center
          </button>
        </div>
      </div>

      <div class="glass-card rounded-3xl p-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-1">
            <span class="font-mono text-[10px] uppercase tracking-wider text-roseGlow">Quick Dopamine</span>
            <span class="text-base">🎲</span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed mb-3" id="rouletteText">
            "Tap Roll whenever you need an instant unforced smile."
          </p>
        </div>
        <button type="button" onclick="spinCompliment()" class="w-full py-2 rounded-xl bg-gradient-to-r from-flirtNeon to-rose-600 text-white font-mono text-[10px] font-bold tracking-wider uppercase shadow-md shadow-rose-900/40 hover:scale-[1.02] active:scale-95 transition">
          Roll Validation 🎲
        </button>
      </div>
    </section>

    <!-- 3. THE 'KUCH BHI' 500+ INDIAN CRAVING OVERRIDE WHEEL -->
    <section class="glass-card rounded-3xl p-6 mb-8 text-center">
      <div class="font-mono text-xs uppercase tracking-widest text-roseGlow mb-1 flex items-center justify-center gap-1.5">
        <span>●</span> The 'Kuch Bhi' 500+ Food & Craving Override Wheel
      </div>
      <p class="text-xs text-slate-400 mb-3">When Sneha says "kuch bhi mangwa lo" for Indian snacks, lunch, dinner, or sweet cravings:</p>

      <div class="flex flex-wrap justify-center gap-1.5 mb-4" id="foodFilterBar">
        <button type="button" onclick="setFoodCategory('all', this)" class="food-cat-btn active px-3 py-1 rounded-full font-mono text-[10px] uppercase tracking-wider bg-roseGlow text-black font-bold transition">
          All (500+)
        </button>
        <button type="button" onclick="setFoodCategory('snacks', this)" class="food-cat-btn px-3 py-1 rounded-full font-mono text-[10px] uppercase tracking-wider bg-white/5 border border-white/10 text-slate-300 hover:bg-white/10 transition">
          Indian Snacks 🥟
        </button>
        <button type="button" onclick="setFoodCategory('meals', this)" class="food-cat-btn px-3 py-1 rounded-full font-mono text-[10px] uppercase tracking-wider bg-white/5 border border-white/10 text-slate-300 hover:bg-white/10 transition">
          Lunch & Dinner 🍛
        </button>
        <button type="button" onclick="setFoodCategory('desserts', this)" class="food-cat-btn px-3 py-1 rounded-full font-mono text-[10px] uppercase tracking-wider bg-white/5 border border-white/10 text-slate-300 hover:bg-white/10 transition">
          Sweets & Coffee 🍨
        </button>
      </div>

      <div class="bg-black/50 border border-rose-400/20 rounded-2xl p-4 mb-4">
        <div class="font-mono text-[10px] text-rose-300 uppercase tracking-widest mb-1" id="kuchBhiCategory">INDIAN STREET SNACKS • #142 OF 500+</div>
        <div class="text-xl md:text-2xl font-bold text-white mb-1.5 transition-all duration-150" id="kuchBhiResult">Crispy Pani Puri & Ragda Pattice with Extra Teekha Pani 🥟</div>
        <div class="font-script text-lg md:text-xl text-rose-200 leading-snug" id="kuchBhiDirective">"Zero debates permitted. Once the wheel locks, Sneha has to eat every single bite."</div>
      </div>

      <button type="button" onclick="spinKuchBhiWheel()" id="spinBtn" class="w-full py-3 rounded-full bg-gradient-to-r from-amber-500/20 via-rose-500/30 to-purple-500/20 border border-rose-400/40 text-xs font-mono font-semibold tracking-wider uppercase text-rose-200 hover:bg-roseGlow hover:text-black transition duration-300">
        Spin 500+ Indian Cravings Slot Machine 🎰
      </button>
    </section>

    <!-- 4. UPGRADED 50+ RANDOM GOLD SCRATCH-CARD & BIOMETRIC SENSOR -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
      <!-- Upgraded Gold Scratch-Off Note -->
      <section class="glass-card rounded-3xl p-6 flex flex-col justify-between relative overflow-hidden">
        <div>
          <div class="flex items-center justify-between mb-1">
            <div class="font-mono text-xs uppercase tracking-widest text-roseGlow flex items-center gap-1.5">
              <span>●</span> Gold Scratch-Off Note
            </div>
            <span id="scratchPercentTag" class="font-mono text-[10px] text-amber-300/80 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-400/20">
              0% Scratched
            </span>
          </div>
          <p class="text-xs text-slate-400 mb-3">Rub the metallic foil to reveal a hidden note for Sneha:</p>

          <div class="scratch-container border border-amber-400/40 shadow-inner relative rounded-2xl overflow-hidden h-[155px]">
            <div class="absolute inset-0 bg-gradient-to-br from-rose-950/80 via-[#120714] to-slate-950 p-4 flex flex-col justify-center items-center text-center">
              <div id="scratchNoteHeader" class="font-mono text-[10px] text-amber-300 uppercase tracking-widest mb-1.5">
