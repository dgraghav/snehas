                 onmousedown="startBiometricHold(event)" 
                 onmouseup="endBiometricHold()" 
                 onmouseleave="endBiometricHold()"
                 ontouchstart="startBiometricHold(event)" 
                 ontouchend="endBiometricHold()"
                 class="w-16 h-16 rounded-full bg-gradient-to-tr from-rose-900/60 to-rose-400/40 border border-rose-300/60 flex items-center justify-center text-2xl text-roseGlow shadow-lg shadow-rose-900/50 transition-transform active:scale-95">
