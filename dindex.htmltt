    <!-- 5. BLACK HOLE: BURN YOUR STRESS -->
    <section class="glass-card rounded-3xl p-6 mb-8 max-w-2xl mx-auto">
      <div class="font-mono text-xs uppercase tracking-widest text-roseGlow mb-1 flex items-center gap-1.5">
        <span>●</span> Stress Vaporizer (Black Hole Mode)
      </div>
      <p class="text-xs text-slate-400 mb-3">Type whatever thought is frustrating or draining you right now, then release it into the quantum void:</p>

      <textarea id="stressInput" rows="2" placeholder="Write here... (this will not be stored anywhere)" class="w-full bg-black/40 border border-white/10 rounded-2xl p-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-roseGlow transition duration-300 resize-none mb-3"></textarea>

      <button type="button" onclick="burnStressThought()" class="w-full py-2.5 rounded-full bg-gradient-to-r from-rose-500/20 via-rose-500/30 to-purple-500/20 border border-rose-400/40 text-xs font-mono font-semibold tracking-wider uppercase text-rose-200 hover:bg-roseGlow hover:text-black transition duration-300">
        Disintegrate Into Cosmic Dust 🔥
      </button>
    </section>

    <!-- Direct WhatsApp Transmission Gateway (+91 9595882171) -->
    <section class="text-center pt-4">
      <a id="whatsappTransmitBtn" 
         href="https://wa.me/919595882171?text=Hey!%20Was%20exploring%20my%20Little%20Universe...%20this%203D%20space%20is%20genuinely%20so%20special%20%E2%9C%A8" 
         target="_blank" 
         rel="noopener noreferrer"
         class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-full bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-semibold text-sm tracking-wide shadow-xl shadow-emerald-950/50 hover:scale-[1.02] active:scale-95 transition duration-300">
        <span>Transmit Direct Signal</span> 💬
      </a>
      <p class="font-mono text-[11px] text-slate-400 mt-4 tracking-wider">
        A LITTLE UNIVERSE FOR SNEHA SHERKE • CRAFTED WITH CARE BY <span class="text-rose-300 font-semibold">RAGHAV</span>
      </p>
    </section>

  </div>

  <!-- JAVASCRIPT: FIXED AUDIO ENGINE, 3D HEARTS & INTERACTIVE MODULES -->
  <script>
    const TARGET_WHATSAPP_NUMBER = "919595882171";

    /* =========================================================
       0. FIXED BACKGROUND MUSIC CONTROLLER (gaurai.mp3)
       ========================================================= */
    const bgMusic = document.getElementById('bgMusic');
    const musicIcon = document.getElementById('musicIcon');
    const musicLabel = document.getElementById('musicLabel');
    let userPausedManually = false;
    let fileLoadError = false;

    if (bgMusic) {
      bgMusic.volume = 0.6;

      bgMusic.addEventListener('error', () => {
        fileLoadError = true;
        if (musicIcon) musicIcon.innerText = '⚠️';
        if (musicLabel) musicLabel.innerText = 'Check gaurai.mp3';
      });

      bgMusic.addEventListener('play', () => updateMusicButtonUI(true));
      bgMusic.addEventListener('pause', () => updateMusicButtonUI(false));
    }

    function updateMusicButtonUI(playing) {
      if (!musicIcon || !musicLabel || fileLoadError) return;
      if (playing) {
        musicIcon.innerText = '⏸️';
        musicLabel.innerText = 'Playing';
      } else {
        musicIcon.innerText = '🎵';
        musicLabel.innerText = 'Play Song';
      }
    }

    function toggleBgMusic(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      if (!bgMusic) return;

      if (bgMusic.paused) {
        userPausedManually = false;
        bgMusic.play().then(() => {
          updateMusicButtonUI(true);
        }).catch(err => {
          console.warn('Playback issue:', err);
          if (musicLabel) musicLabel.innerText = 'Tap Again';
        });
      } else {
        userPausedManually = true;
        bgMusic.pause();
        updateMusicButtonUI(false);
      }
    }

    // Automatically start gaurai.mp3 when user interacts with any button on screen
    function tryAutoStartMusic(e) {
      if (userPausedManually || !bgMusic || !bgMusic.paused) return;
      if (e && e.target && e.target.closest('#musicToggleBtn')) return;
      bgMusic.play().then(() => {
        updateMusicButtonUI(true);
      }).catch(() => {});
    }
    document.addEventListener('pointerdown', tryAutoStartMusic);

    let scene, camera, renderer;
    let beatingHeartSwarm, celestialRings, crystalHeart;
    let floatingHearts = [];
    let targetRotationX = 0, targetRotationY = 0;
    let windowHalfX = window.innerWidth / 2;
    let windowHalfY = window.innerHeight / 2;
    let webglAvailable = true;
    let supernovaParticles = [];
    let heartParticleMat;
    let sharedHeartTexture;
    let activeMoodKey = 'flirt';

    function createGlowingHeartTexture() {
      const size = 128;
      const canvas = document.createElement('canvas');
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d');

      ctx.clearRect(0, 0, size, size);
      ctx.shadowColor = '#ff1e56';
      ctx.shadowBlur = 16;

      const cx = size / 2;
      const cy = size / 2 - 22;
      const s = 3.2;

      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.moveTo(cx, cy + 5 * s);
      ctx.bezierCurveTo(cx, cy, cx - 12 * s, cy - 5 * s, cx - 12 * s, cy + 4 * s);
      ctx.bezierCurveTo(cx - 12 * s, cy + 12 * s, cx, cy + 20 * s, cx, cy + 24 * s);
      ctx.bezierCurveTo(cx, cy + 20 * s, cx + 12 * s, cy + 12 * s, cx + 12 * s, cy + 4 * s);
      ctx.bezierCurveTo(cx + 12 * s, cy - 5 * s, cx, cy, cx, cy + 5 * s);
      ctx.closePath();
      ctx.fill();

      const texture = new THREE.CanvasTexture(canvas);
      texture.needsUpdate = true;
      return texture;
    }

    function createHeartShape() {
      const x = 0, y = 0;
      const h = new THREE.Shape();
      h.moveTo(x + 0.25, y + 0.25);
      h.bezierCurveTo(x + 0.25, y + 0.25, x + 0.2, y, x, y);
      h.bezierCurveTo(x - 0.3, y, x - 0.3, y + 0.35, x - 0.3, y + 0.35);
      h.bezierCurveTo(x - 0.3, y + 0.55, x - 0.1, y + 0.77, x + 0.25, y + 0.95);
      h.bezierCurveTo(x + 0.6, y + 0.77, x + 0.8, y + 0.55, x + 0.8, y + 0.35);
      h.bezierCurveTo(x + 0.8, y + 0.35, x + 0.8, y, x + 0.5, y);
      h.bezierCurveTo(x + 0.35, y, x + 0.25, y + 0.25, x + 0.25, y + 0.25);
      return h;
    }

    function init3D() {
      const canvas = document.getElementById('webglCanvas');
      try {
        if (typeof THREE === 'undefined') {
          throw new Error('Three.js library not loaded');
        }
        scene = new THREE.Scene();

        camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 19;

        renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        const ambientLight = new THREE.AmbientLight(0xffffff, 1.3);
        scene.add(ambientLight);

        const frontLight = new THREE.PointLight(0xff2a70, 3.5, 60);
        frontLight.position.set(0, 3, 14);
        scene.add(frontLight);

        const sideLight = new THREE.PointLight(0xff8fa3, 2.5, 50);
        sideLight.position.set(-10, -5, 10);
        scene.add(sideLight);

        const rimLight = new THREE.DirectionalLight(0xffffff, 1.2);
        rimLight.position.set(5, 10, 10);
        scene.add(rimLight);

        sharedHeartTexture = createGlowingHeartTexture();
        const particleCount = 650;
        const geometry = new THREE.BufferGeometry();
        const positions = new Float32Array(particleCount * 3);
        const colors = new Float32Array(particleCount * 3);

        for (let i = 0; i < particleCount * 3; i += 3) {
          const r = 6 + Math.random() * 24;
          const theta = Math.random() * Math.PI * 2;
          const phi = Math.acos((Math.random() * 2) - 1);

          positions[i] = r * Math.sin(phi) * Math.cos(theta);
          positions[i + 1] = r * Math.sin(phi) * Math.sin(theta);
          positions[i + 2] = r * Math.cos(phi) - 2;

          colors[i] = 1.0;
          colors[i + 1] = 0.25 + Math.random() * 0.45;
          colors[i + 2] = 0.5 + Math.random() * 0.4;
        }

        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

        heartParticleMat = new THREE.PointsMaterial({
          size: 0.95,
          map: sharedHeartTexture,
          vertexColors: true,
          transparent: true,
          opacity: 0.95,
          alphaTest: 0.05,
          depthWrite: false,
          blending: THREE.AdditiveBlending
        });

        beatingHeartSwarm = new THREE.Points(geometry, heartParticleMat);
        scene.add(beatingHeartSwarm);

        celestialRings = new THREE.Group();
        const ringGeo1 = new THREE.TorusGeometry(5.2, 0.035, 16, 80);
        const ringMat1 = new THREE.MeshBasicMaterial({ color: 0xff1e56, transparent: true, opacity: 0.45 });
        const ring1 = new THREE.Mesh(ringGeo1, ringMat1);
        ring1.rotation.x = Math.PI / 3;
        celestialRings.add(ring1);

        const ringGeo2 = new THREE.TorusGeometry(6.6, 0.025, 16, 90);
        const ringMat2 = new THREE.MeshBasicMaterial({ color: 0xffd166, transparent: true, opacity: 0.35 });
        const ring2 = new THREE.Mesh(ringGeo2, ringMat2);
        ring2.rotation.y = Math.PI / 4;
        celestialRings.add(ring2);

        scene.add(celestialRings);

        const heartShape = createHeartShape();
        const mainExtrudeSettings = {
          depth: 0.45,
          bevelEnabled: true,
          bevelSegments: 6,
          steps: 2,
          bevelSize: 0.14,
          bevelThickness: 0.16
        };

        const heartGeometry = new THREE.ExtrudeGeometry(heartShape, mainExtrudeSettings);
        heartGeometry.center();

        const heartMaterial = new THREE.MeshStandardMaterial({
          color: 0xff1e56,
          emissive: 0x700824,
          emissiveIntensity: 0.85,
          roughness: 0.18,
          metalness: 0.35,
          transparent: true,
          opacity: 0.95
        });

        crystalHeart = new THREE.Mesh(heartGeometry, heartMaterial);
        crystalHeart.scale.set(3.8, 3.8, 3.8);
        crystalHeart.rotation.z = Math.PI;
        scene.add(crystalHeart);

        const miniExtrudeSettings = {
          depth: 0.2,
          bevelEnabled: true,
          bevelSegments: 3,
          steps: 1,
          bevelSize: 0.06,
          bevelThickness: 0.06
        };
        const miniHeartGeo = new THREE.ExtrudeGeometry(heartShape, miniExtrudeSettings);
        miniHeartGeo.center();

        const miniHeartMat = new THREE.MeshStandardMaterial({
          color: 0xff4d6d,
          emissive: 0x55061c,
          emissiveIntensity: 0.7,
          roughness: 0.25,
          metalness: 0.25,
          transparent: true,
          opacity: 0.9
        });

        for (let i = 0; i < 45; i++) {
          const mesh = new THREE.Mesh(miniHeartGeo, miniHeartMat.clone());
          const scale = 0.65 + Math.random() * 0.95;
          mesh.scale.set(scale, scale, scale);
          mesh.rotation.z = Math.PI;

          const distance = 5.0 + Math.random() * 11;
          const theta = Math.random() * Math.PI * 2;
          const phi = (Math.random() - 0.5) * Math.PI;

          mesh.position.set(
            distance * Math.cos(theta) * Math.cos(phi),
            distance * Math.sin(phi),
            distance * Math.sin(theta) * Math.cos(phi) - 1
          );

          scene.add(mesh);
          floatingHearts.push({
            mesh: mesh,
            baseScale: scale,
            rotSpeedX: (Math.random() - 0.5) * 0.02,
            rotSpeedY: (Math.random() - 0.5) * 0.025,
            pulseOffset: Math.random() * Math.PI * 2
          });
        }

        window.addEventListener('resize', onWindowResize, false);
        window.addEventListener('mousemove', onMouseMove, false);
        window.addEventListener('touchmove', onTouchMove, { passive: true });
        window.addEventListener('dblclick', triggerHeartSupernova);
      } catch (err) {
        console.warn("WebGL fallback initiated:", err);
        webglAvailable = false;
        if (canvas) canvas.style.display = 'none';
      }
    }

    function onWindowResize() {
      if (!webglAvailable) return;
      windowHalfX = window.innerWidth / 2;
      windowHalfY = window.innerHeight / 2;
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function onMouseMove(event) {
      if (!webglAvailable) return;
      targetRotationX = (event.clientY - windowHalfY) * 0.0003;
      targetRotationY = (event.clientX - windowHalfX) * 0.0003;
    }

    function onTouchMove(event) {
      if (!webglAvailable || !event.touches.length) return;
      targetRotationX = (event.touches[0].clientY - windowHalfY) * 0.0004;
      targetRotationY = (event.touches[0].clientX - windowHalfX) * 0.0004;
    }

    function resetCameraAngle() {
      targetRotationX = 0;
      targetRotationY = 0;
      if (crystalHeart) crystalHeart.rotation.set(0, 0, Math.PI);
    }

    function triggerHeartSupernova() {
      if (!webglAvailable || !scene) return;
      const burstCount = 65;
      const burstGeo = new THREE.BufferGeometry();
      const burstPos = new Float32Array(burstCount * 3);
      const velocities = [];

      for (let i = 0; i < burstCount; i++) {
        burstPos[i * 3] = 0;
        burstPos[i * 3 + 1] = 0;
        burstPos[i * 3 + 2] = 0;

        velocities.push({
          x: (Math.random() - 0.5) * 0.75,
          y: (Math.random() - 0.5) * 0.75,
          z: (Math.random() - 0.5) * 0.75
        });
      }

      burstGeo.setAttribute('position', new THREE.BufferAttribute(burstPos, 3));
      const burstMat = new THREE.PointsMaterial({
        color: 0xff8fa3,
        map: sharedHeartTexture,
        size: 1.1,
        transparent: true,
        opacity: 1,
        depthWrite: false,
        blending: THREE.AdditiveBlending
      });

      const burstMesh = new THREE.Points(burstGeo, burstMat);
      scene.add(burstMesh);
      supernovaParticles.push({ mesh: burstMesh, vels: velocities, life: 1.0 });

      floatingHearts.forEach(fh => {
        fh.mesh.scale.multiplyScalar(1.38);
      });

      playSynthHeartbeat(580, 0.08);
    }

    function animate() {
      if (!webglAvailable) return;
      requestAnimationFrame(animate);

      const time = Date.now() * 0.0015;

      const pulseRate = activeMoodKey === 'flirt' ? 3.8 : 2.6;
      const phase = (time * pulseRate) % (Math.PI * 2);
      let pulse = 1.0;
      if (phase < 0.6) {
        pulse += Math.sin(phase * (Math.PI / 0.6)) * 0.16;
      } else if (phase >= 0.8 && phase < 1.4) {
        pulse += Math.sin((phase - 0.8) * (Math.PI / 0.6)) * 0.25;
      }

      if (beatingHeartSwarm && heartParticleMat) {
        beatingHeartSwarm.rotation.y = time * 0.045;
        beatingHeartSwarm.rotation.x = Math.sin(time * 0.3) * 0.12;
        heartParticleMat.size = 0.95 * pulse;
      }

      if (celestialRings) {
        celestialRings.rotation.y = -time * 0.06;
        celestialRings.rotation.x = Math.sin(time * 0.5) * 0.2;
      }

      if (crystalHeart) {
        crystalHeart.scale.set(3.8 * pulse, 3.8 * pulse, 3.8 * pulse);
        crystalHeart.rotation.y += (targetRotationY * 5 - crystalHeart.rotation.y) * 0.05;
        crystalHeart.rotation.x += (targetRotationX * 5 - (crystalHeart.rotation.x - Math.PI)) * 0.05;
      }

      floatingHearts.forEach(fh => {
        fh.mesh.position.y += Math.sin(time * 1.5 + fh.pulseOffset) * 0.015;
        fh.mesh.position.x += Math.cos(time * 0.8 + fh.pulseOffset) * 0.008;
        fh.mesh.rotation.y += fh.rotSpeedY;
        fh.mesh.rotation.x += fh.rotSpeedX;

        const heartScale = fh.baseScale * (0.92 + (pulse - 1.0) * 1.4);
        fh.mesh.scale.set(heartScale, heartScale, heartScale);
      });

      for (let i = supernovaParticles.length - 1; i >= 0; i--) {
        const p = supernovaParticles[i];
        p.life -= 0.02;
        const posArr = p.mesh.geometry.attributes.position.array;
        for (let j = 0; j < p.vels.length; j++) {
          posArr[j * 3] += p.vels[j].x;
          posArr[j * 3 + 1] += p.vels[j].y;
          posArr[j * 3 + 2] += p.vels[j].z;
        }
        p.mesh.geometry.attributes.position.needsUpdate = true;
        p.mesh.material.opacity = p.life;

        if (p.life <= 0) {
          scene.remove(p.mesh);
          supernovaParticles.splice(i, 1);
        }
      }

      renderer.render(scene, camera);
    }

    function update3DThemeColor(hexColor) {
      if (!webglAvailable || !crystalHeart) return;
      crystalHeart.material.color.set(hexColor);
      crystalHeart.material.emissive.set(hexColor).multiplyScalar(0.35);
      if (celestialRings && celestialRings.children[0]) {
        celestialRings.children[0].material.color.set(hexColor);
      }
      floatingHearts.forEach(fh => {
        fh.mesh.material.color.set(hexColor);
        fh.mesh.material.emissive.set(hexColor).multiplyScalar(0.3);
      });
    }

    /* =========================================================
       2. WEB AUDIO API SYNTHESIZER
       ========================================================= */
    let audioCtx = null;
    function playSynthHeartbeat(freq = 110, duration = 0.25) {
      try {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) return;
        if (!audioCtx) audioCtx = new AudioContextClass();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(45, audioCtx.currentTime + duration);

        gain.gain.setValueAtTime(0.35, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {}
    }

    /* =========================================================
       3. TOP 1,000+ ENGLISH FLIRT COMBINATORIAL MATRIX (10x10x10)
       ========================================================= */
    const englishFlirtMatrix = {
      openers: [
        "Honestly Sneha, smiling at your phone like that should officially be illegal,",
        "I've been analyzing this closely, Sneha, and you have this completely unfair habit:",
        "You pretend to be so unbothered and strict, but here's the truth,",
        "Just so we are clear, Sneha, whenever you take over the music queue in the car,",
        "Not to inflate your ego today, but sitting beside you during an empty highway cruise",
        "You have this quiet, effortless superpower where you don't even have to try,",
        "I need you to stop biting your lip and pretending you aren't paying attention,",
        "Between your innocent 'kuch bhi' tantrums and that little dimpled smile,",
        "Even on your most chaotic days when you swear you look like a mess,",
        "You can pretend all you want that you don't secretly love being teased,"
      ],
      teases: [
        "you somehow manage to reset my entire afternoon in two seconds flat.",
        "you look dangerously breathtaking while pretending to be deep in thought.",
        "you make every other plan in this city feel completely ordinary and boring.",
        "nobody has the power to distract people from their actual work the way you do.",
        "that sudden eye-roll followed by a soft, shy smile is genuinely unfair.",
        "taking 25 minutes to decide on dessert is officially the most adorable crime.",
        "the way your eyes light up over cold coffee and inside jokes is unmatched.",
        "you command the passenger seat like you legally own every single highway lane.",
        "your genuine laugh carries more warmth than this entire universe combined.",
        "you carry an elegance that makes everyone else in the room fade into blur."
      ],
      punchlines: [
        "So go ahead, smile at the screen again—I know you're doing it right now.",
        "Now close this message, drink your cold coffee, and know you're cherished.",
        "And yes, the front seat aux cord remains permanently reserved under your name.",
        "So stop arguing with your food cravings and let me handle the dessert order.",
        "Consider this your official reminder that you are effortlessly unmatched.",
        "Now tell me: when are we taking that next spontaneous late-night coffee drive?",
        "Don't worry, your secrets and all your silly tantrums are completely safe with me.",
        "You're a rare one, Sneha Sherke, and having you around is the easiest win.",
        "Just keep that radiant crown straight and never stop being this charming.",
        "Now admit it with a straight face: this just made your entire day ten times better."
      ],
