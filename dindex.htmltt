    function setMood(moodKey, btnElement) {
      activeMoodKey = moodKey;
      document.querySelectorAll('.mood-pill').forEach(btn => {
        btn.classList.remove('active', 'border-flirtNeon/60', 'shadow-md', 'shadow-rose-950/50', 'bg-gradient-to-r', 'from-flirtNeon/20', 'to-rose-500/10');
        btn.classList.add('border-transparent', 'bg-white/[0.02]');
        const dot = btn.querySelector('.rounded-full');
        if (dot) dot.remove();
        const label = btn.querySelector('span:last-child');
        if (label) {
          label.classList.remove('font-bold', 'text-rose-200');
          label.classList.add('font-medium', 'text-slate-300');
        }
      });

      if (btnElement) {
        btnElement.classList.remove('border-transparent', 'bg-white/[0.02]');
        btnElement.classList.add('active', 'border-flirtNeon/60', 'shadow-md', 'shadow-rose-950/50', 'bg-gradient-to-r', 'from-flirtNeon/20', 'to-rose-500/10');
        const label = btnElement.querySelector('span:last-child');
        if (label) {
          label.classList.remove('font-medium', 'text-slate-300');
          label.classList.add('font-bold', 'text-rose-200');
        }
        const indicator = document.createElement('span');
        indicator.className = 'w-1.5 h-1.5 rounded-full bg-flirtNeon';
        btnElement.appendChild(indicator);
      }

      const data = proceduralLibrary[moodKey];
      document.getElementById('ambientGlow').style.background = data.glowStyle;
      update3DThemeColor(data.color);

      document.getElementById('activeMoodTag').innerText = data.tag;
      document.getElementById('actionProtocol').innerHTML = `
        <strong class="font-mono uppercase text-flirtNeon block text-[10px] tracking-wider mb-0.5">Note To Self</strong>
        ${data.protocol}
      `;

      const encoded = encodeURIComponent(data.waPrompt);
      document.getElementById('whatsappTransmitBtn').href = `https://wa.me/${TARGET_WHATSAPP_NUMBER}?text=${encoded}`;
      generateProceduralMessage();
    }

    function generateProceduralMessage() {
      const data = proceduralLibrary[activeMoodKey];
      const messageElem = document.getElementById('messageDisplay');
      const hindiElem = document.getElementById('shayariHindiDisplay');

      messageElem.style.opacity = '0';
      if (hindiElem) hindiElem.style.opacity = '0';

      setTimeout(() => {
        if (activeMoodKey === 'flirt') {
          const op = englishFlirtMatrix.openers[Math.floor(Math.random() * englishFlirtMatrix.openers.length)];
          const te = englishFlirtMatrix.teases[Math.floor(Math.random() * englishFlirtMatrix.teases.length)];
          const pu = englishFlirtMatrix.punchlines[Math.floor(Math.random() * englishFlirtMatrix.punchlines.length)];
          const hi = englishFlirtMatrix.hinglishEchoes[Math.floor(Math.random() * englishFlirtMatrix.hinglishEchoes.length)];

          messageElem.innerText = `"${op} ${te} ${pu}"`;
          messageElem.style.opacity = '1';

          if (hindiElem) {
            hindiElem.style.display = 'block';
            hindiElem.innerHTML = `"${hi}"`;
            hindiElem.style.opacity = '1';
          }

          const randCount = Math.floor(Math.random() * 1000) + 1;
          document.getElementById('matrixCounter').innerText = `Permutation #${randCount} of 1,000+`;
        } else {
          if (hindiElem) hindiElem.style.display = 'none';
          const o = data.openers[Math.floor(Math.random() * data.openers.length)];
          const c = data.cores[Math.floor(Math.random() * data.cores.length)];
          const a = data.anchors[Math.floor(Math.random() * data.anchors.length)];

          messageElem.innerText = `"${o} ${c} ${a}"`;
          messageElem.style.opacity = '1';

          const randVariation = Math.floor(Math.random() * 1500) + 1;
          document.getElementById('matrixCounter').innerText = `Resonance #${randVariation} of 1,728`;
        }
      }, 150);
    }

