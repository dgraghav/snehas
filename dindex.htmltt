    let selectedFoodCat = 'all';

    function setFoodCategory(cat, btn) {
      selectedFoodCat = cat;
      document.querySelectorAll('.food-cat-btn').forEach(b => {
        b.classList.remove('active', 'bg-roseGlow', 'text-black', 'font-bold');
        b.classList.add('bg-white/5', 'text-slate-300');
      });
      if (btn) {
        btn.classList.add('active', 'bg-roseGlow', 'text-black', 'font-bold');
        btn.classList.remove('bg-white/5', 'text-slate-300');
      }
      spinKuchBhiWheel();
    }

    function getRandomIndianFoodItem() {
      const keys = selectedFoodCat === 'all' ? ['snacks', 'meals', 'desserts'] : [selectedFoodCat];
      const chosenKey = keys[Math.floor(Math.random() * keys.length)];
      const bucket = indianFoodMatrix[chosenKey];

      const dish = bucket.dishes[Math.floor(Math.random() * bucket.dishes.length)];
      const pairing = bucket.pairings[Math.floor(Math.random() * bucket.pairings.length)];
      const dir = bucket.directives[Math.floor(Math.random() * bucket.directives.length)];
      const itemNum = Math.floor(Math.random() * 525) + 1;

      return {
        category: `${bucket.label} • #${itemNum} OF 525+ CRAVINGS`,
        food: `${dish} ${pairing}`,
        dir: dir
      };
    }

    function spinKuchBhiWheel() {
      const btn = document.getElementById('spinBtn');
      if (btn.disabled) return;
      btn.disabled = true;
      let counter = 0;
      const interval = setInterval(() => {
        const temp = getRandomIndianFoodItem();
        document.getElementById('kuchBhiResult').innerText = temp.food;
        document.getElementById('kuchBhiCategory').innerText = temp.category;
        counter++;
        playSynthHeartbeat(200 + counter * 20, 0.05);
        if (counter > 10) {
          clearInterval(interval);
          const finalPick = getRandomIndianFoodItem();
          document.getElementById('kuchBhiResult').innerText = finalPick.food;
          document.getElementById('kuchBhiCategory').innerText = finalPick.category;
          document.getElementById('kuchBhiDirective').innerText = `"${finalPick.dir}"`;
          btn.disabled = false;
        }
      }, 65);
    }

