    let lastNoteIndex = -1;
    const scratchCanvas = document.getElementById('scratchCanvas');
    const sCtx = scratchCanvas.getContext('2d', { willReadFrequently: true });
    let isScratching = false;
    let isRevealed = false;
    let scratchMoveCounter = 0;

    function pickRandomSecretNote() {
      let randomIndex;
      do {
        randomIndex = Math.floor(Math.random() * secretScratchNotes.length);
      } while (randomIndex === lastNoteIndex && secretScratchNotes.length > 1);
      
      lastNoteIndex = randomIndex;
      const headerEl = document.getElementById('scratchNoteHeader');
      const bodyEl = document.getElementById('scratchNoteBody');
      
      if (headerEl) {
        headerEl.innerText = `✦ Secret Note #${randomIndex + 1} of ${secretScratchNotes.length} ✦`;
      }
      if (bodyEl) {
        bodyEl.innerText = `"${secretScratchNotes[randomIndex]}"`;
      }
    }

    function initScratchFoil() {
      const parent = scratchCanvas.parentElement;
      const width = parent.clientWidth || 320;
      const height = parent.clientHeight || 155;

      scratchCanvas.width = width;
      scratchCanvas.height = height;
      scratchCanvas.style.opacity = '1';
      scratchCanvas.style.pointerEvents = 'auto';
      isRevealed = false;
      scratchMoveCounter = 0;

      document.getElementById('scratchPercentTag').innerText = '0% Scratched';

      sCtx.globalCompositeOperation = 'source-over';
      const grad = sCtx.createLinearGradient(0, 0, width, height);
      grad.addColorStop(0, '#b8860b');
      grad.addColorStop(0.3, '#f6d365');
      grad.addColorStop(0.55, '#fde68a');
      grad.addColorStop(0.8, '#d4af37');
      grad.addColorStop(1, '#996515');
      sCtx.fillStyle = grad;
      sCtx.fillRect(0, 0, width, height);

      sCtx.strokeStyle = 'rgba(255, 255, 255, 0.22)';
      sCtx.lineWidth = 2;
      for (let i = -height; i < width + height; i += 14) {
        sCtx.beginPath();
        sCtx.moveTo(i, 0);
        sCtx.lineTo(i + height, height);
        sCtx.stroke();
      }

      sCtx.fillStyle = '#3b2504';
      sCtx.font = 'bold 12px "JetBrains Mono", monospace';
      sCtx.textAlign = 'center';
      sCtx.fillText('✦ RUB FOIL TO UNLOCK SECRET ✦', width / 2, height / 2 + 4);
    }

    function checkScratchCompletion() {
      if (isRevealed) return;
      const pixels = sCtx.getImageData(0, 0, scratchCanvas.width, scratchCanvas.height).data;
      let transparentPixels = 0;
      const totalPixels = pixels.length / 4;

      for (let i = 3; i < pixels.length; i += 16) {
        if (pixels[i] === 0) transparentPixels++;
      }

      const percent = Math.min(100, Math.round((transparentPixels / (totalPixels / 4)) * 100));
      document.getElementById('scratchPercentTag').innerText = `${percent}% Scratched`;

      if (percent >= 55) {
        isRevealed = true;
        document.getElementById('scratchPercentTag').innerText = '100% Unlocked ✨';
        scratchCanvas.style.opacity = '0';
        scratchCanvas.style.pointerEvents = 'none';
        if (typeof triggerHeartSupernova === 'function') triggerHeartSupernova();
        if (typeof playSynthHeartbeat === 'function') playSynthHeartbeat(440, 0.25);
      }
    }

    function scratch(e) {
      if (!isScratching || isRevealed) return;
      const rect = scratchCanvas.getBoundingClientRect();
      const clientX = e.clientX !== undefined ? e.clientX : (e.touches && e.touches[0] ? e.touches[0].clientX : 0);
      const clientY = e.clientY !== undefined ? e.clientY : (e.touches && e.touches[0] ? e.touches[0].clientY : 0);
      const x = clientX - rect.left;
      const y = clientY - rect.top;

      sCtx.globalCompositeOperation = 'destination-out';
      sCtx.beginPath();
      sCtx.arc(x, y, 24, 0, Math.PI * 2);
      sCtx.fill();

      scratchMoveCounter++;
      if (scratchMoveCounter % 6 === 0) {
        checkScratchCompletion();
      }
    }

    scratchCanvas.addEventListener('mousedown', (e) => { isScratching = true; scratch(e); });
    window.addEventListener('mouseup', () => { if (isScratching) { isScratching = false; checkScratchCompletion(); } });
    scratchCanvas.addEventListener('mousemove', scratch);

    scratchCanvas.addEventListener('touchstart', (e) => { isScratching = true; scratch(e); }, { passive: true });
    window.addEventListener('touchend', () => { if (isScratching) { isScratching = false; checkScratchCompletion(); } });
    scratchCanvas.addEventListener('touchmove', scratch, { passive: true });

    function resetScratchFoil(loadNextNote = true) {
      if (loadNextNote) {
        pickRandomSecretNote();
      }
      initScratchFoil();
      if (typeof playSynthHeartbeat === 'function') playSynthHeartbeat(260, 0.1);
    }

    /* =========================================================
       6. BIOMETRIC HOLD & REAL-TIME CLOCK
       ========================================================= */
    let holdTimer = null;
    let holdProgress = 0;
    const progressCircle = document.getElementById('holdProgressCircle');
    const touchFeedback = document.getElementById('touchFeedback');
    const totalCircumference = 264;

    const warmComfortQuotes = [
      "Your presence brings a quiet calm that makes the loudest days feel completely manageable.",
      "No matter how fast the world moves around us, Sneha... you will always be a place of quiet peace.",
      "You are held in the warmest, safest corner of this universe—always protected, always cherished.",
      "The aux cord will forever be reserved for you. Take a deep, gentle breath.",
      "You are valued, admired, and never, ever an inconvenience."
    ];

    function startBiometricHold(e) {
      if (e && e.cancelable) e.preventDefault();
      holdProgress = 0;
      touchFeedback.innerText = "Syncing Neural Resonance...";
      touchFeedback.style.opacity = "0.7";

      playSynthHeartbeat(110, 0.4);

      clearInterval(holdTimer);
      holdTimer = setInterval(() => {
        holdProgress += 6;
        const offset = totalCircumference - (holdProgress / 100) * totalCircumference;
        progressCircle.style.strokeDashoffset = offset;

        if (holdProgress % 24 === 0) playSynthHeartbeat(130, 0.2);

        if (holdProgress >= 100) {
          clearInterval(holdTimer);
          triggerBiometricCelebration();
        }
      }, 50);
    }

    function endBiometricHold() {
      clearInterval(holdTimer);
      holdProgress = 0;
      progressCircle.style.strokeDashoffset = totalCircumference;
    }

    function triggerBiometricCelebration() {
      const q = warmComfortQuotes[Math.floor(Math.random() * warmComfortQuotes.length)];
      touchFeedback.innerText = `"${q}"`;
      touchFeedback.style.opacity = "1";

      playSynthHeartbeat(220, 0.6);
      triggerHeartSupernova();

      if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
    }

    function burnStressThought() {
      const input = document.getElementById('stressInput');
      const text = input.value.trim();
      if (!text) return;
      input.classList.add('disintegrate');
      playSynthHeartbeat(80, 0.5);

      setTimeout(() => {
        input.value = "";
        input.classList.remove('disintegrate');
        input.placeholder = "✓ Vaporized into the 3D cosmic void. It has zero power over you now.";
      }, 700);
    }

    function updateLiveClock() {
      const now = new Date();
      const hrs = String(now.getHours()).padStart(2, '0');
      const mins = String(now.getMinutes()).padStart(2, '0');
      const secs = String(now.getSeconds()).padStart(2, '0');
      document.getElementById('liveClock').innerText = `${hrs}:${mins}:${secs} IST`;
    }
    setInterval(updateLiveClock, 1000);

    window.addEventListener('DOMContentLoaded', function () {
      init3D();
      animate();
      generateProceduralMessage();
      pickRandomSecretNote();
      initScratchFoil();
      updateLiveClock();
    });
  </script>
</body>
</html>
